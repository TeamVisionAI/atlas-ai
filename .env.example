# Atlas AI — environment template (copy to .env and fill in real values)
# Never commit .env or real secrets.

# Server
PORT=3000
# Atlas runtime environment: development | staging | production
# Leave unset on production Railway unless explicitly promoting ATLAS_ENV=production.
# Staging Railway must set ATLAS_ENV=staging. Never point staging at production Supabase.
# ATLAS_ENV=
# Required when ATLAS_ENV=staging. Must NOT be gjuheeztwxbnscjobkzm.
# ATLAS_EXPECTED_SUPABASE_REF=
# Staging outbound delivery (WhatsApp/email/calendar/SMS/voice). Default false.
# STAGING_OUTBOUND_COMMUNICATION_ENABLED=false
# Optional local file: .env.staging.local (see docs/03-engineering/ENVIRONMENT_STRATEGY.md)
# ATLAS_STAGING_ENV_FILE=.env.staging.local
# Public Atlas UI origin for password reset / invitation links (backend emails).
# Local dev: http://localhost:5173 (Vite). Production (Railway): https://www.teamvisionfinancial.com
FRONTEND_URL=http://localhost:5173
# Legacy aliases also supported: ATLAS_FRONTEND_URL, APP_URL

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend server writes — required in production when RLS is enabled (LC1)
SUPABASE_SERVICE_ROLE_KEY=
# Dev tooling only (Sprint 15.5+) — Supabase → Project Settings → Database
# Use DATABASE_URL or SUPABASE_DB_PASSWORD for migration apply / RC1 certification
DATABASE_URL=
SUPABASE_DB_PASSWORD=

# WhatsApp Cloud API (existing test-number integration)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
VERIFY_TOKEN=
# BR-078 — Approved Meta template catalog (inactive placeholders only).
# Do not set approved/active or real Meta names until Meta approval + explicit ops authorization.
# Locale keys must be english/spanish. See docs/03-engineering/WHATSAPP_TEMPLATE_APPROVAL_PACKET.md
# WHATSAPP_APPROVED_TEMPLATES_JSON={"interview_reminder":{"english":{"metaTemplateName":null,"approved":false,"active":false},"spanish":{"metaTemplateName":null,"approved":false,"active":false}}}
WHATSAPP_APPROVED_TEMPLATES_JSON=

# Facebook Messenger (Sprint 12.1 — Communication Gateway)
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=

# Atlas AI (Sprint 12.2 — Communication Gateway AI adapter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Meta Embedded Signup (Sprint 6 — server-side only except public App ID / Config ID in frontend)
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0
META_TOKEN_ENCRYPTION_KEY=

# Public website contact form (Resend — server-side only)
RESEND_API_KEY=
CONTACT_FORM_FROM_EMAIL=Team Vision Financial <notifications@teamvisionfinancial.com>
CONTACT_FORM_TO_EMAIL=contact@teamvisionfinancial.com
# LC1.1 — identity emails (invitations, password reset)
ATLAS_EMAIL_FROM=Team Vision Financial <notifications@teamvisionfinancial.com>

# Set VITE_META_APP_ID to the same value as META_APP_ID for the browser SDK.
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v25.0

# Google Calendar (interview booking — required for full MVP pipeline)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Preferred production callback (must match Google Cloud authorized redirect URIs exactly):
# https://<railway-backend-host>/api/configuration/scheduling/google/callback
GOOGLE_CONFIGURATION_REDIRECT_URI=
# Legacy alias — only accepted when it uses the configuration callback path above.
GOOGLE_REDIRECT_URI=
# Used to derive the callback when GOOGLE_CONFIGURATION_REDIRECT_URI is unset.
# Also used as the public origin encoded into Campaign Manager QR URLs (/go/<token>).
# The normalized origin of this URL is included in the production CORS allowlist so
# browser form POSTs to /go/:token/bind are not rejected before the QR route runs.
ATLAS_PUBLIC_URL=
GOOGLE_REFRESH_TOKEN=

# QR Campaign Manager Phase A (Settings → QR Campaigns)
# Architecture is multi-tenant; creation is org-allowlisted until WhatsApp destination
# and interstitial branding are tenant-configurable.
# QR_CAMPAIGN_MANAGER_ENABLED=true
# QR_CAMPAIGN_MANAGER_ORGANIZATION_IDS=00000000-0000-4000-8000-000000000001
# Dedicated 32-byte key (base64 or 64-char hex). Never reuse JWT/service-role secrets.
# QR_CHANNEL_TOKEN_ENCRYPTION_KEY=

# Frontend API base URL
# Local dev: leave empty — Vite proxies /api to http://localhost:3000 (see frontend/vite.config.js)
# Production (Vercel): set to your Railway API URL, e.g. https://your-service.up.railway.app
VITE_API_BASE_URL=
# Development only — never ship bootstrap tokens in production frontend builds.
VITE_ATLAS_BOOTSTRAP_TOKEN=
# Development only — default password for seeded LC1 users (see seedAtlasUsers.js)
# Production uses /app/setup wizard — never seed users in production
ATLAS_DEV_DEFAULT_PASSWORD=AtlasDev2026!

# Recruit AI v2 — production shadow evaluation (BR-081 Phase 3). Defaults keep shadow off.
# Do not enable in production without explicit approval. CE remains authoritative.
# Empty ORGANIZATION_IDS = no orgs eligible (fail closed). sampleRate 0 = no execution.
RECRUIT_AI_V2_SHADOW_ENABLED=false
RECRUIT_AI_V2_SHADOW_ORGANIZATION_IDS=
RECRUIT_AI_V2_SHADOW_SAMPLE_RATE=0
RECRUIT_AI_V2_SHADOW_TIMEOUT_MS=5000
# Optional JSON override: {"enabled":false,"organizationIds":[],"sampleRate":0}
# RECRUIT_AI_V2_SHADOW_CONFIG=

# Recruit AI v2 — continuous context capture (BR-081 Phase 3B). Separate from shadow sample.
# Defaults OFF. 100% capture ≠ 100% shadow. Does NOT mean v2 owns the conversation.
RECRUIT_AI_V2_CONTEXT_CAPTURE_ENABLED=false
RECRUIT_AI_V2_CONTEXT_CAPTURE_ORGANIZATION_IDS=
RECRUIT_AI_V2_CONTEXT_CAPTURE_SAMPLE_RATE=0
RECRUIT_AI_V2_CONTEXT_CAPTURE_TIMEOUT_MS=5000
# RECRUIT_AI_V2_CONTEXT_CAPTURE_CONFIG=

# Must remain false until an explicit cutover sprint.
RECRUIT_AI_V2_EXECUTION_ENABLED=false
RECRUIT_AI_V2_LIVE_EXECUTION_PATH_ENABLED=false

# Production security
# Comma-separated extra allowed browser origins (defaults include teamvisionfinancial.com, www, localhost:5173)
ATLAS_CORS_ORIGINS=
# Required in production for unsigned internal intake paths (if used)
ATLAS_INTERNAL_SERVICE_SECRET=
# Facebook Lead Ads webhook verify token (falls back to META_VERIFY_TOKEN)
FACEBOOK_LEAD_VERIFY_TOKEN=
