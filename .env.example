# Atlas AI — environment template (copy to .env and fill in real values)
# Never commit .env or real secrets.

# Server
PORT=3000
# Public Atlas UI origin for password reset / invitation links (backend emails).
# Local dev: http://localhost:5173 (Vite). Production (Railway): https://www.teamvisionfinancial.com
FRONTEND_URL=http://localhost:5173
# Legacy aliases also supported: ATLAS_FRONTEND_URL, APP_URL

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend server writes — required in production when RLS is enabled (LC1)
SUPABASE_SERVICE_ROLE_KEY=
# Dev tooling only (Sprint 15.5+) — Supabase → Project Settings → Database
# Use DATABASE_URL or SUPABASE_DB_PASSWORD for migration apply / RC1 certification
DATABASE_URL=
SUPABASE_DB_PASSWORD=

# WhatsApp Cloud API (existing test-number integration)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
VERIFY_TOKEN=

# Facebook Messenger (Sprint 12.1 — Communication Gateway)
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=

# Atlas AI (Sprint 12.2 — Communication Gateway AI adapter)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Meta Embedded Signup (Sprint 6 — server-side only except public App ID / Config ID in frontend)
# Meta App Review demo environment — set true with VITE_META_REVIEW_MODE on the frontend
META_REVIEW_MODE=false
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0
META_TOKEN_ENCRYPTION_KEY=

# Public website contact form (Resend — server-side only)
RESEND_API_KEY=
CONTACT_FORM_FROM_EMAIL=Team Vision Financial <notifications@teamvisionfinancial.com>
CONTACT_FORM_TO_EMAIL=contact@teamvisionfinancial.com
# LC1.1 — identity emails (invitations, password reset)
ATLAS_EMAIL_FROM=Team Vision Financial <notifications@teamvisionfinancial.com>

# Set VITE_META_APP_ID to the same value as META_APP_ID for the browser SDK.
VITE_META_APP_ID=
VITE_META_EMBEDDED_SIGNUP_CONFIG_ID=
VITE_META_GRAPH_API_VERSION=v25.0
VITE_META_REVIEW_MODE=false

# Google Calendar (interview booking — required for full MVP pipeline)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Frontend API base URL
# Local dev: leave empty — Vite proxies /api to http://localhost:3000 (see frontend/vite.config.js)
# Production (Vercel): set to your Railway API URL, e.g. https://your-service.up.railway.app
VITE_API_BASE_URL=
# Development only — never ship bootstrap tokens in production frontend builds.
VITE_ATLAS_BOOTSTRAP_TOKEN=
# Development only — default password for seeded LC1 users (see seedAtlasUsers.js)
# Production uses /app/setup wizard — never seed users in production
ATLAS_DEV_DEFAULT_PASSWORD=AtlasDev2026!

# Production security
# Comma-separated extra allowed browser origins (defaults include teamvisionfinancial.com, www, localhost:5173)
ATLAS_CORS_ORIGINS=
# Required in production for unsigned internal intake paths (if used)
ATLAS_INTERNAL_SERVICE_SECRET=
# Facebook Lead Ads webhook verify token (falls back to META_VERIFY_TOKEN)
FACEBOOK_LEAD_VERIFY_TOKEN=
