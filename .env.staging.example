# Atlas staging-local env template.
# Copy to `.env.staging.local` (gitignored) and fill real staging values.
# Never copy production secrets. Never point this file at production Supabase.
#
# Load intentionally:
#   ATLAS_STAGING_ENV_FILE=.env.staging.local npm run dev
#   npm run staging:migrate
#   npm run staging:seed
#
# WARNING: the default repo `.env` currently targets production Supabase
# (gjuheeztwxbnscjobkzm). Do not overwrite `.env` with this file unless you
# explicitly intend to stop using production from local.

ATLAS_ENV=staging
NODE_ENV=production
ATLAS_EXPECTED_SUPABASE_REF=jmobhvoscivanvsqpnwk

# Staging Supabase only — must NOT be gjuheeztwxbnscjobkzm
SUPABASE_URL=https://jmobhvoscivanvsqpnwk.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Staging-only secrets — generate new values. Do not reuse production.
JWT_SECRET=
ATLAS_JWT_SECRET=
ATLAS_BOOTSTRAP_TOKEN=
ATLAS_INTERNAL_SERVICE_SECRET=
STAGING_SEED_PASSWORD=

FRONTEND_URL=http://localhost:5173
ATLAS_PUBLIC_URL=http://localhost:3000
ATLAS_CORS_ORIGINS=http://localhost:5173,https://localhost:5173

RECRUIT_AI_V2_EXECUTION_ENABLED=false
RECRUIT_AI_V2_LIVE_EXECUTION_PATH_ENABLED=false
STAGING_OUTBOUND_COMMUNICATION_ENABLED=false

# Do NOT add production WhatsApp / WABA / Resend / Google Calendar credentials.
# Staging uses fixture/webhook simulation only on day one.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
VERIFY_TOKEN=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
