# Frontend staging-local / Vercel Preview template.
# Public non-secret defaults live in committed `.env.staging` (Preview `--mode staging`).
# Copy this file to `frontend/.env.staging.local` (gitignored) only for extra local secrets.
# Never inherit production Railway. Never commit bootstrap tokens.

VITE_ATLAS_ENV=staging
VITE_API_BASE_URL=https://atlas-ai-staging-staging.up.railway.app
VITE_ATLAS_BOOTSTRAP_TOKEN=

# Keep Meta Review off unless a staging review persona is being demonstrated.
VITE_META_REVIEW_MODE=false
